# Copy to .env for local development
DATABASE_URL=postgresql://postgres:dev@localhost:5432/proresume
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=https://proresume.aeloriacareer.com
CORS_ORIGINS=https://proresume.aeloriacareer.com,https://aeloriacareer.com,https://ai-proresume.netlify.app
PORT=3001

# Stripe - API auto-provisions products, prices, and webhook on deploy when STRIPE_SECRET_KEY is set.
# Optional overrides (otherwise resolved automatically):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...

# Optional Railway volume mount path
# DATA_DIR=/data

# xAI Grok - live AI suggestions (https://console.x.ai)
# XAI_API_KEY=xai-...
# XAI_MODEL=grok-4.3

# Optional Railway Redis plugin (job queue signals)
# REDIS_URL=redis://...

# Resend — verification emails (API) + contact form (worker)
# RESEND_API_KEY=re_...
# Active inbox for contact notifications and reply-to on outbound mail:
# SUPPORT_EMAIL=support@aeloriacareer.com
# FROM_EMAIL=ProResume AI <noreply@aeloriacareer.com>
# REPLY_TO_EMAIL=support@aeloriacareer.com
