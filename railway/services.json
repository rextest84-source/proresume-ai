{
  "project": "proresume-ai",
  "rootDirectory": ".",
  "services": [
    {
      "name": "proresume-ai",
      "config": "services/api/railway.toml",
      "dockerfile": "services/api/Dockerfile",
      "sharedVariables": ["DATABASE_URL", "JWT_SECRET", "FRONTEND_URL", "CORS_ORIGINS"],
      "serviceVariables": ["STRIPE_SECRET_KEY", "XAI_API_KEY", "XAI_MODEL", "REDIS_URL"]
    },
    {
      "name": "proresume-worker",
      "config": "services/worker/railway.toml",
      "dockerfile": "services/worker/Dockerfile",
      "sharedVariables": ["DATABASE_URL", "JWT_SECRET", "FRONTEND_URL"],
      "serviceVariables": ["REDIS_URL", "RESEND_API_KEY", "SUPPORT_EMAIL", "FROM_EMAIL", "WORKER_POLL_MS"]
    },
    {
      "name": "proresume-cron",
      "config": "services/cron/railway.toml",
      "dockerfile": "services/cron/Dockerfile",
      "sharedVariables": ["DATABASE_URL", "JWT_SECRET", "FRONTEND_URL"],
      "serviceVariables": ["CRON_INTERVAL_MS"]
    }
  ],
  "plugins": [
    {
      "name": "Postgres",
      "required": true,
      "provides": ["DATABASE_URL"]
    },
    {
      "name": "Redis",
      "required": false,
      "provides": ["REDIS_URL"],
      "linkTo": ["proresume-ai", "proresume-worker"]
    }
  ]
}
