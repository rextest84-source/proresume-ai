{
  "project": "proresume-ai",
  "rootDirectory": "backend",
  "services": [
    {
      "name": "proresume-ai",
      "configFile": "services/api/railway.toml",
      "startCommand": "node src/index.js"
    },
    {
      "name": "proresume-worker",
      "configFile": "services/worker/railway.toml",
      "startCommand": "node src/worker.js"
    },
    {
      "name": "proresume-cron",
      "configFile": "services/cron/railway.toml",
      "startCommand": "node src/cron.js"
    }
  ],
  "plugins": [
    { "name": "Postgres", "required": true, "provides": ["DATABASE_URL"] },
    { "name": "Redis", "required": false, "provides": ["REDIS_URL"] }
  ],
  "sharedVariables": ["DATABASE_URL", "JWT_SECRET", "FRONTEND_URL", "CORS_ORIGINS", "RESEND_API_KEY", "FROM_EMAIL"]
}
